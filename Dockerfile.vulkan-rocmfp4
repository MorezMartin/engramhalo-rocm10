# Qwen3.8-Flash-Next ROCmFP4-FAST image — LaurentZuijdwijk/llama.cpp fork
# (branch vulkan/qwen4exp-rocmfpx), Vulkan backend.
# The ROCmFP4 quant types need THIS fork; on this branch the FP4 fast paths are
# wired into Vulkan (HIP kernels exist but are not wired). Build follows the
# fork's .devops/vulkan.Dockerfile, on a Fedora base (same as the rocm10 image;
# docker.io base layers trigger a Docker Hub cross-repo blob-mount bug).
#
#   podman build -f Dockerfile.vulkan-rocmfp4 -t localhost/engramhalo-rocmfp4:latest .
#   distrobox create --name llama-fp4 --image localhost/engramhalo-rocmfp4:latest -- \
#     --device /dev/dri --security-opt seccomp=unconfined
#
# Model: https://huggingface.co/agentionai/Qwen3.8-Flash-Next-ROCmFP4-FAST-imatrix-GGUF
# MTP sidecar: https://huggingface.co/agentionai/Qwen3.8-Flash-Next-MTP-ROCmFP4-FAST-GGUF

FROM registry.fedoraproject.org/fedora:44 AS builder

RUN dnf -y --nodocs --setopt=install_weak_deps=False \
  install \
  make gcc gcc-c++ cmake libcurl-devel ninja-build \
  git-core sudo rsync patch \
  vulkan-headers vulkan-loader-devel glslc spirv-headers-devel \
  && dnf clean all && rm -rf /var/cache/dnf/*

WORKDIR /app
ARG REPO=https://github.com/LaurentZuijdwijk/llama.cpp.git
ARG BRANCH=vulkan/qwen4exp-rocmfpx
RUN git clone --single-branch --recursive --depth 1 -b ${BRANCH} ${REPO} . \
  && cmake -B build \
     -DGGML_NATIVE=OFF \
     -DGGML_VULKAN=ON \
     -DLLAMA_BUILD_TESTS=OFF \
     -DCMAKE_BUILD_TYPE=Release \
  && cmake --build build --config Release -j$(nproc) \
  && cmake --install build --config Release

FROM registry.fedoraproject.org/fedora-minimal:44

RUN microdnf -y --nodocs --setopt=install_weak_deps=0 \
  install \
  bash ca-certificates libcurl libatomic libstdc++ libgcc libgomp sudo \
  vulkan-loader mesa-vulkan-drivers \
  && microdnf clean all && rm -rf /var/cache/dnf/*

COPY --from=builder /usr/local/ /usr/local/
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf \
  && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
  && ldconfig

CMD ["/bin/bash"]
